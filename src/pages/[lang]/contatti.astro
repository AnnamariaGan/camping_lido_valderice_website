---
import { locales } from '../../i18n/config';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import type { RouteKey } from '../../i18n/config';
import { ui } from '../../i18n/ui';
import heroContatti from '../../assets/hero-contatti.webp';
import mapStatic from '../../assets/map-static.webp';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
const route: RouteKey = 'contatti';
const u = ui[lang];

const mapQuery = 'Campeggio Lido Valderice, Via della Conchiglia 20, 91019 Valderice TP, Italia';
const waHref = (tel) => `https://wa.me/${tel.replace(/\D/g, '')}`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;
const mapEmbed =
  `https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3141.0092246426652!2d12.629164915719427!3d38.070166279706726` +
  `!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x13197b4f2fe2a039%3A0x980e5b685b9ce6d2!2sCampeggio%20Lido%20Valderice` +
  `!5e0!3m2!1s${lang}!2s${lang}!4v1649282247276!5m2!1s${lang}!2s${lang}`;
---

<Base
  lang={lang}
  route={route}
  title={u.meta.pages.contatti}
  description={u.meta.descriptions.contatti}
  ogImage={heroContatti}
>
  <Hero img={heroContatti} title={u.meta.pages.contatti} alt={u.meta.heroAlt.contatti} compact />

  <section class="section">
    <div class="wrap">
      <div class="contact-grid">
        <div class="contact-card">
          <h2>{u.contatti.heading}</h2>
          <address>
            <div class="contact-row">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"></path></svg>
              <span><strong>{u.contatti.street}</strong> — {u.contatti.city}</span>
            </div>
            <div class="contact-row">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 4h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1zm8 7L4.5 6.2v-.7h15v.7L12 11zm0 2.3 7.5-5.4V18h-15V7.9l7.5 5.4z"></path></svg>
              <a href={`mailto:${u.contatti.email}`}>{u.contatti.email}</a>
            </div>
            <div class="contact-row">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"></path></svg>
              <span>
                <a href={`tel:${u.contatti.phoneSeason.tel}`}>{u.contatti.phoneSeason.label}</a>
              </span>
            </div>
          </address>
          <ul class="contact-list">
            {
              u.contatti.contacts.map((contact) => (
                <li class="contact-row">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"></path></svg>
                  <span><strong>{contact.name}</strong> <a href={`tel:${contact.tel}`}>{contact.phone}</a></span>
                  <a class="wa-link" href={waHref(contact.tel)} target="_blank" rel="noopener" aria-label={`WhatsApp ${contact.name}`}>
                    <svg viewBox="-1.5 -1.5 27 27" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"></path></svg>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="map-block" data-map-src={mapEmbed} data-map-img={mapStatic.src} data-map-title={u.contatti.mapTitle}>
          <button
            type="button"
            class="map-preview"
            aria-expanded="false"
            aria-controls="map-consent"
            aria-label={u.contatti.mapTitle}
          >
            <img src={mapStatic.src} alt="" width="1024" height="768" loading="lazy" decoding="async" />
          </button>
          <div class="map-consent" id="map-consent" hidden>
            <p class="map-notice">{u.common.mapNotice}</p>
            <p class="map-actions">
              <button type="button" class="btn" data-map-load>{u.common.mapLoad}</button>
              <a class="map-open" href={mapLink} target="_blank" rel="noopener">{u.common.mapOpen}</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  (() => {
    const block = document.querySelector('[data-map-src]');
    if (!block) return;
    const CONSENT_KEY = 'clv-map-consent';
    const preview = block.querySelector('.map-preview');
    const panel = block.querySelector('.map-consent');
    let loaded = false;

    const loadMap = () => {
      if (loaded) return;
      loaded = true;
      // L'immagine statica resta visibile finché l'embed Google non ha finito di caricarsi.
      const live = document.createElement('div');
      live.className = 'map-live';
      const img = document.createElement('img');
      img.src = block.dataset.mapImg;
      img.alt = '';
      img.decoding = 'async';
      const frame = document.createElement('iframe');
      frame.src = block.dataset.mapSrc;
      frame.title = block.dataset.mapTitle;
      frame.loading = 'lazy';
      frame.referrerPolicy = 'no-referrer-when-downgrade';
      frame.allowFullscreen = true;
      frame.addEventListener('load', () => {
        live.classList.add('loaded');
        setTimeout(() => img.remove(), 500);
      });
      live.append(img, frame);
      block.replaceChildren(live);
      try {
        localStorage.setItem(CONSENT_KEY, '1');
      } catch {}
    };

    const showConsent = () => {
      if (loaded) return;
      preview.setAttribute('aria-expanded', 'true');
      panel.hidden = false;
    };

    const hideConsent = () => {
      if (loaded) return;
      preview.setAttribute('aria-expanded', 'false');
      panel.hidden = true;
    };

    preview.addEventListener('click', showConsent);

    // Perdita del focus (tastiera) o clic fuori dal riquadro: torna la sola immagine statica.
    block.addEventListener('focusout', (event) => {
      if (!block.contains(event.relatedTarget)) hideConsent();
    });
    document.addEventListener('click', (event) => {
      if (panel.hidden === false && !block.contains(event.target)) hideConsent();
    });

    block.querySelector('[data-map-load]').addEventListener('click', loadMap);
    block.querySelector('.map-open').addEventListener('click', hideConsent);

    let consented = false;
    try {
      consented = localStorage.getItem(CONSENT_KEY) === '1';
    } catch {}
    if (consented) loadMap();
  })();
</script>

